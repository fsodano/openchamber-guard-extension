{
  "name": "openchamber-guard-extension",
  "version": "0.1.0",
  "private": true,
  "description": "OpenChamber extension and OpenCode plugin that block shell and subagent actions by user-defined guards.",
  "type": "module",
  "license": "UNLICENSED",
  "files": [
    "extension/icon.svg",
    "extension/panel/index.html",
    "extension/panel/main.js",
    "extension/panel/status.html",
    "extension/panel/status.js",
    "extension/service/main.js",
    "extension/plugin/index.js"
  ],
  "scripts": {
    "test": "bun run test:unit && bun run test:service && bun run test:panel",
    "test:unit": "bun test test/unit",
    "test:service": "bun test extension/test/service",
    "test:panel": "bun test extension/test/panel.test.ts extension/test/guards",
    "test:integration": "bun test test/integration --timeout 180000",
    "typecheck": "tsc --noEmit",
    "build:all": "bun run plugin:build && bun run service:build && bun run panel:build",
    "plugin:build": "bun scripts/build-extension-plugin.ts",
    "plugin:check": "bun scripts/build-extension-plugin.ts --check",
    "service:build": "openchamber-guest-bundle --node extension/service/main.ts extension/service/main.js",
    "panel:build": "openchamber-guest-bundle extension/panel/main.ts extension/panel/main.js && openchamber-guest-bundle extension/panel/status.ts extension/panel/status.js",
    "extension:check": "bun run plugin:check && openchamber-guest-check ."
  },
  "openchamber": {
    "apiVersion": 1,
    "engines": {
      "openchamber": ">=2.7.0"
    },
    "id": "openchamber-guard-extension",
    "name": "Guard extension",
    "icon": "extension/icon.svg",
    "contributes": {
      "panel": {
        "entry": "extension/panel/index.html"
      },
      "statusSection": {
        "entry": "extension/panel/status.html",
        "title": "Guards",
        "height": 48,
        "requiresProject": false
      },
      "capabilities": [
        "model",
        "sessions"
      ],
      "service": {
        "entry": "extension/service/main.js",
        "runtime": "host",
        "provides": [
          "opencode"
        ]
      },
      "opencodePlugin": "extension/plugin"
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "21.0.4",
    "@opencode/plugin": "2.0.32",
    "@openchamber/sdk": "2.7.0",
    "@types/bun": "1.3.0",
    "happy-dom": "21.0.4",
    "typescript": "5.9.3"
  }
}
